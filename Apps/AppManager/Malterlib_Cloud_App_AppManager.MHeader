%Target "Lib_Malterlib_Cloud_AppManager"
{
	Property
	{
		MalterlibConcurrency_DistributedAppPrefixHeader true
	}
	Target
	{
		Type "StaticLibrary"
		BaseName "Malterlib_Cloud_AppManager"
		Group "Apps"
	}
	%Group "Source"
	{
		%File "Source/Malterlib_Cloud_App_*"
	}

	%Dependency "Lib_Malterlib_Cloud"
	{
		Dependency.Indirect true
	}
	%Dependency "Lib_Malterlib"
	{
		Dependency.Indirect true
	}
}

%Target "Malterlib_Cloud_AppManager"
{
	Property
	{
		ProductName "Malterlib Cloud App Manager"
		MalterlibTestApp true
		MalterlibPostCopyProject "Malterlib_Cloud_AppManager"
		{
			!!MalterlibPostCopyProject undefined
		}
		MalterlibPostCopyProject2 "Malterlib_Cloud_AppManager"
		{
			!!MalterlibCloud_PerAppPostCopyActive true
		}
		MalterlibTargetNameType "Normal"
		MalterlibCloudVersionInfo_Executable ""

		// The host monitor patch and reboot checks need these tools, which minimal
		// installations like container images do not include
		MalterlibCloudVersionInfo_OSDependencies {ubuntu: ["update-notifier-common", "needrestart"]}
	}
	Target
	{
		DebuggerCommandArguments ["--daemon-run-debug"]
		BaseFileName "AppManager"
		Group "Apps"
		ExtraGroups =+ "{Malterlib}/{CloudTarBinaries}"
	}
	%Group "Source"
	{
		%File "Source/Malterlib_Cloud_AppLocal_*"
	}

	Property
	{
		// Virtualization.framework requires the com.apple.security.virtualization entitlement to host VMs
		MalterlibSignMacOSEntitlements "Resources/macOS/Virtualization.entitlements"->MakeAbsolute()
		{
			&
			{
				PlatformIsDarwin true
				!MalterlibForNotarization true
			}
		}
		// Notarization rejects the debugging entitlement
		MalterlibSignMacOSEntitlements "Resources/macOS/VirtualizationNotarization.entitlements"->MakeAbsolute()
		{
			&
			{
				PlatformIsDarwin true
				MalterlibForNotarization true
			}
		}
	}

	%Dependency "Lib_Malterlib_Cloud_AppManager"
}

Property
{
	Malterlib_App_Enable_AppManager: bool = true

	MalterlibModules =+ "Virtualization"

	Malterlib_Cloud_App_Targets =+ "Malterlib_Cloud_AppManager"
	{
		!!Malterlib_App_Enable_AppManager true
	}
}
